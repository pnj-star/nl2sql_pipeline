# ============================================================
# nl2sql_skill 配置模板（.env.example）
# ------------------------------------------------------------
# 使用方法：复制成 .env 后按自己的环境填写，不要直接改本文件。
#   Windows:  Copy-Item .env.example .env
#   Linux:    cp .env.example .env
# .env 会被 .gitignore 忽略，不会进仓库；本文件只负责说明每个变量。
# 代码里几乎所有变量都有默认值，留空就是走默认行为，不用每项都硬填。
# ============================================================

# --- LLM（OpenAI 兼容；SQL 生成必填）---
# OpenAI 兼容接口地址，如 https://api.openai.com/v1 或企业网关地址。
NL2SQL_LLM_BASE_URL=

# LLM 接口密钥。只存在 .env 里，不要提交到仓库或写死进代码。
NL2SQL_LLM_API_KEY=

# 生成 SQL 使用的模型名，例如 gpt-4o-mini / deepseek-v4-flash / qwen-plus。
NL2SQL_LLM_MODEL=

# 采样温度：0 = 完全确定，NL2SQL 建议保持 0 保证同一问题生成稳定。
NL2SQL_LLM_TEMPERATURE=0

# 单次 LLM 输出的最大 token 数；SQL 通常很短，2048 足够。
NL2SQL_LLM_MAX_TOKENS=2048

# LLM 请求超时（秒）。
NL2SQL_LLM_TIMEOUT_SECONDS=30

# --- 数据源（至少注册一个，格式 NL2SQL_DB_<ID>_DSN）---
# <ID> 只允许大写字母/数字/下划线；调用时传小写 db_id 即可匹配。
# 连接串格式: mysql://readonly_user:password@host:port/database
# 安全要求：必须使用只读账号，即使护栏失守也无法写入。
NL2SQL_DB_ERP_DSN=mysql://ro_user:ro_pass@127.0.0.1:3306/erp_db

# MySQL 大版本声明（"8.0" / "5.7"）。5.x 会注入受限语法子集提示（禁窗口函数/CTE）。
NL2SQL_DB_ERP_SERVER_VERSION=8.0

# 可见表白名单，逗号分隔小写表名。留空表示全部快照内表可见。
# 示例：orders,shops,products
NL2SQL_DB_ERP_VISIBLE_TABLES=

# --- 语义层 ---
# YAML/JSON 配置目录路径，存放业务别名、描述、时间过滤声明等。
# 留空表示不启用语义层（召回退化为纯词法匹配）。
NL2SQL_SEMANTIC_DIR=./semantic

# --- 行为参数 ---
# 置信阈值：LLM 自评 confidence 低于该值时触发澄清。
# 注意：LLM 自评存在虚高风险，仅作参考信号之一。
NL2SQL_CLARIFY_THRESHOLD=0.75

# 执行侧默认行数上限（LIMIT 强制追加/压低到该值）。
NL2SQL_MAX_ROWS=200

# 多轮 history 的 token 预算，超出时从最早轮次截断。
NL2SQL_HISTORY_MAX_TOKENS=2000

# schema 召回注入 prompt 的上下文 token 预算，超出时截断低分候选表。
NL2SQL_SCHEMA_CONTEXT_MAX_TOKENS=4000

# 召回候选表数量上限（含外键一跳扩展后的总数）。
NL2SQL_TOP_K_TABLES=8

# few-shot 示例注入的最小相似度阈值（FR-7）：
# 低于该值的示例不注入；示例库未启用时该值不生效。
NL2SQL_EXAMPLE_MIN_SIMILARITY=0.75

# --- few-shot 示例库（FR-7，读侧）---
# JSONL 示例库路径；每行 {"question","sql","db_id"?,"verified"?,"tenant_id"?}。
# 留空表示不启用示例库；启用后 pipeline 按 db/tenant 隔离 + 相似度召回注入。
# 写侧（去重、复用护栏校验）由外部运营工具负责。
NL2SQL_EXAMPLE_STORE_PATH=

# --- EXPLAIN 成本闸门（FR-5.3）---
# execute=true 时对 SQL 执行 EXPLAIN，预估扫描行数超过上限则拒绝执行，
# 拦截结果映射为 rejected_guardrail（不缓存、不重试）。
NL2SQL_COST_GUARD_ENABLED=false
# 预估扫描行数上限；超过即拒绝执行。默认 500 万行。
NL2SQL_COST_THRESHOLD_ROWS=5000000
# EXPLAIN 失败（连接/权限/语法）时的策略：
# deny=拒绝执行（默认，fail-closed），allow=放行并告警（fail-open）。
NL2SQL_EXPLAIN_FAIL_POLICY=deny

# --- SQL 缓存 ---
# 缓存开关。命中后跳过 LLM 但仍重跑护栏校验。
NL2SQL_SQL_CACHE_ENABLED=true

# SQL 缓存过期时间（秒）。默认 24h。
NL2SQL_SQL_CACHE_TTL_SECONDS=86400

# 是否把多轮 history 的 hash 加入缓存 key。
# 默认 false：避免多轮会话每追加一轮就 miss，命中率损失大于收益。
NL2SQL_CACHE_KEY_INCLUDE_HISTORY=false

# --- 鉴权 ---
# disabled=本地/内部调试，只校验 tenant_id / db_id / request_id 是否齐全；
# jwt=校验 JWT，需配置 AUTH_JWT_SECRET / AUTH_JWT_PUBLIC_KEY / AUTH_JWKS_URL 之一。
# 公网部署请改为 jwt 并填好密钥，不要用 disabled。
AUTH_MODE=disabled
# AUTH_JWT_SECRET=
# AUTH_JWT_ISSUER=
# AUTH_JWT_AUDIENCE=
