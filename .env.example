# ===== nl2sql_skill 环境变量模板（复制为 .env 后按需修改） =====

# --- LLM（OpenAI 兼容协议；前缀 NL2SQL_LLM_，由 common_core.LLMConfig 解析） ---
NL2SQL_LLM_BASE_URL=https://api.example.com/v1
NL2SQL_LLM_API_KEY=sk-xxx
NL2SQL_LLM_MODEL=gpt-4o-mini
NL2SQL_LLM_TEMPERATURE=0.0
NL2SQL_LLM_MAX_TOKENS=2048

# --- 数据源注册：每个数据源一组 NL2SQL_DB_<ID>_* 变量，<ID> 即 db_id ---
# DSN 格式: mysql://用户名:密码@主机:端口/库名（必须使用只读账号）
NL2SQL_DB_ERP_DSN=mysql://readonly:secret@127.0.0.1:3306/erp
# 可选：声明服务器版本以选择语法子集（默认 8.0）
NL2SQL_DB_ERP_SERVER_VERSION=8.0
# 可选：逗号分隔的可见表白名单；留空表示全部表可见
NL2SQL_DB_ERP_VISIBLE_TABLES=orders,shops

# --- 语义层目录：存放 *.json / *.yaml 描述文件（同义词、指标口径等） ---
NL2SQL_SEMANTIC_DIR=./semantic

# --- 行为开关与预算 ---
NL2SQL_CLARIFY_THRESHOLD=0.75
NL2SQL_MAX_ROWS=200
NL2SQL_HISTORY_MAX_TOKENS=2000
NL2SQL_SCHEMA_CONTEXT_MAX_TOKENS=4000
NL2SQL_TOP_K_TABLES=8
NL2SQL_EXAMPLE_MIN_SIMILARITY=0.75

# --- SQL 缓存 ---
NL2SQL_SQL_CACHE_ENABLED=true
NL2SQL_SQL_CACHE_TTL_SECONDS=86400
# 默认 false：history 参与 key 会让多轮会话每追加一轮就 miss；
# 需要严格区分多轮前缀时才打开。执行超时由执行器侧（如 SQL_READ_TIMEOUT）管理。
NL2SQL_CACHE_KEY_INCLUDE_HISTORY=false

# --- Redis（common_core 通用前缀） ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
