# ============================================================
# nl2sql_skill 示例配置（examples/.env）
# 用法：复制本文件为 examples/.env 后填写，再运行：
#   python examples/run_demo.py            # 真实 LLM 模式
#   python examples/run_demo.py --fake     # 无密钥也能跑通全流程
# ============================================================

# --- LLM（OpenAI 兼容；--fake 模式可留空）---
NL2SQL_LLM_BASE_URL=
NL2SQL_LLM_API_KEY=
NL2SQL_LLM_MODEL=

# --- 数据源：指向你的 test-mysql（docker 映射端口 3307）---
NL2SQL_DB_COMMERCE_DSN=mysql://你的只读账号:你的密码@127.0.0.1:3307/commerce
NL2SQL_DB_COMMERCE_SERVER_VERSION=8.0
NL2SQL_DB_COMMERCE_VISIBLE_TABLES=products,commission_rules

# --- 语义层与 few-shot 示例库（示例已自带文件）---
NL2SQL_SEMANTIC_DIR=./semantic
NL2SQL_EXAMPLE_STORE_PATH=./few_shots/samples.jsonl
NL2SQL_EXAMPLE_MIN_SIMILARITY=0.5

# --- 行为参数（默认值即可）---
NL2SQL_CLARIFY_THRESHOLD=0.75
NL2SQL_MAX_ROWS=200

# --- 缓存（本机演示可留空 = 不开 redis 缓存）---
NL2SQL_SQL_CACHE_ENABLED=false